// Invarail starter preset — Tier 0 (see INSTALL.md).
// One local model does everything; web console only; nothing else to install.
// qwen3.5:9b with thinking OFF is the measured floor for tool use (92% on the harness
// battery, evals/2026-09-small-tier; qwen3.5:9b ties it with better code); on an 8GB
// machine use qwen2.5:7b.
// Every capability above this is one config block — the upgrade path is
// commented inline. Copy to invarail.config.json5 (or let the setup wizard
// do it) and replace the model with one you have pulled in Ollama.
{
  timezone: "America/New_York",

  ollama: {
    url: "http://localhost:11434",
  },

  router: {
    // One category = every message routes to chat. Add categories as you add
    // capabilities (see invarail.config.example.json5 for the full set).
    model: "qwen3.5:9b",
    timeout: 4000,
    defaultCategory: "chat",
    categories: {
      chat: { description: "General conversation, questions, and assistance" },
    },
  },

  specialists: {
    chat: {
      model: "qwen3.5:9b",
      think: false,   // thinking cost this model 5x the time and 12 points on the battery
      temperature: 0.7,
      maxTokens: 2048,
    },
    // Tier 1: add web_search (needs SearXNG from docker-compose.yml or a
    // hosted search key under tools.web.search) and a matching router category.
    // Tier 2: add exec (Docker sandbox), personal (Google OAuth), research.
  },

  channels: {
    // The web console needs no accounts or tokens. Open http://localhost:3100
    // after `npm start`. Set a `token` here before exposing beyond localhost.
    web: {
      enabled: true,
      port: 3100,
      host: "127.0.0.1",   // the console is a localhost tool at this tier. To reach it from other devices: bind 0.0.0.0 AND set token: "${WEB_TOKEN}"
    },
    // Tier 1: discord: { enabled: true, token: "${DISCORD_TOKEN}" }, etc.
  },

  // Memory works out of the box: without FalkorDB (docker-compose.yml) it
  // falls back to flat files under data/. Graph memory upgrades it in place.

  // Personal web index (optional, off by default): curate YOUR sources — the
  // agent crawls them politely (RSS-first, robots.txt, named user-agent) into
  // a local searchable archive that pipelines consult BEFORE web search.
  // These three seeds are ILLUSTRATIVE shapes, not recommendations — your
  // index should reflect what *you* need to stay current on.
  // localIndex: {
  //   enabled: true,
  //   seeds: [
  //     { url: "https://example-vendor.com/blog/rss.xml", kind: "rss", tags: ["vendor"] },
  //     { url: "https://github.com/some/repo/releases.atom", kind: "rss", tags: ["releases"] },
  //     { url: "https://news.ycombinator.com/rss", kind: "rss", tags: ["aggregator"], followLinks: true },
  //   ],
  // },

  session: {
    contextSize: 16384,
  },
}
